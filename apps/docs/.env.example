# Ask AI. Without it the widget renders and every question fails, so the
# trigger is worth hiding when the key is absent.
#
# Create one at https://openrouter.ai/keys — no card required for the free tier.
OPENROUTER_API_KEY=

# Optional. Defaults to a `:free` model, which costs nothing and is capped at
# 20 requests a minute and 50 a day (1000 once the account has ever bought
# credits). Point this at a paid model only as a conscious decision: a public
# endpoint on a paid model is an open invoice.
# OPENROUTER_MODEL=minimax/minimax-m3:free
