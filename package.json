{
  "name": "api-zero",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/api-zero/api-zero.git"
  },
  "license": "MIT",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "format": "biome format --write .",
    "changeset": "changeset",
    "release": "turbo run build && changeset publish",
    "smoke": "bash scripts/smoke-pack.sh",
    "version:packages": "changeset version"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.8",
    "@changesets/changelog-github": "^1.0.0",
    "@changesets/cli": "^2.29.8",
    "turbo": "latest",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@9.0.0"
}
