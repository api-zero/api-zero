{
  "name": "@api-zero/react",
  "version": "0.1.1",
  "description": "React bindings for api-zero — ApiProvider and useApi.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/api-zero/api-zero.git",
    "directory": "packages/react"
  },
  "homepage": "https://api-zero.vercel.app",
  "bugs": {
    "url": "https://github.com/api-zero/api-zero/issues"
  },
  "keywords": [
    "api-zero",
    "react",
    "http",
    "client",
    "provider",
    "hook"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "peerDependencies": {
    "@api-zero/core": ">=0.0.1",
    "react": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "lint": "biome check .",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@api-zero/core": "workspace:*",
    "@testing-library/react": "^16.0.0",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "happy-dom": "^15.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsup": "^8.0.0",
    "typescript": "^5.9.3",
    "vitest": "^1.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
