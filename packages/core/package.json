{
  "name": "@api-zero/core",
  "version": "0.0.1",
  "description": "Lightweight, type-safe HTTP client built on the Fetch API with interceptors, retries, and structured errors.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/api-zero/api-zero.git",
    "directory": "packages/core"
  },
  "homepage": "https://api-zero.vercel.app",
  "bugs": {
    "url": "https://github.com/api-zero/api-zero/issues"
  },
  "keywords": [
    "http",
    "client",
    "fetch",
    "api",
    "typescript",
    "interceptors",
    "retry"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "lint": "biome check .",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "vitest": "^1.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
